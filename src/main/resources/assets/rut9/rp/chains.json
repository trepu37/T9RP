{
  // ======================================================================================
  // Граф РП-связок. Свои правила кладите в config/rut9/chains.json (тот же формат, дописываются
  // к встроенным), затем /t9 reload в игре.
  //
  // tags   — темы: имя -> основы слов (ищутся в последних строках чата и в своих РП-действиях).
  //          Вариант с тегом получает буст, если тема «звучит» в чате (Пример: «Покажите документы» -> doc).
  // me     — продолжения для /me, /try и для действия после «*» в /todo (там превращаются в деепричастия).
  //          when   — любая из основ должна встретиться в уже набранном тексте
  //          and    — и ещё любая из этих (необязательно)
  //          unless — если встретилась любая из этих, правило не срабатывает (необязательно)
  //          when пустой — «стартовое» правило: работает, когда после команды ещё ничего не набрано
  //          next   — варианты: строка либо {"t": "текст", "tags": ["doc"], "w": 1.0}
  //                   Текст пишется как продолжение (без точки, строчными): мод сам добавит «и»/запятую.
  // do     — описания для /do (пишите с заглавной и точкой).
  //          afterMe — основы из ваших последних /me /try /todo (до 3 минут назад)
  //          chat    — основы из последних строк чата
  //          оба пусты — стартовое правило
  // speech — реплики для левой части /todo (до «*»), условия chat как выше.
  // Основы пишите строчными; «ё» можно (мод заменит на «е»).
  // ======================================================================================

  "tags": {
    "doc":    ["документ", "паспорт", "удостоверен", "права", "лицензи", "прописк", "предъяв", "покаж"],
    "money":  ["деньг", "налич", "оплат", "штраф", "взятк", "заплат"],
    "phone":  ["телефон", "позвон", "звонок", "номер", "набер"],
    "weapon": ["оружи", "ствол", "пистолет", "стрельб", "огонь"],
    "stop":   ["стой", "остановит", "стоять", "не двигай"],
    "greet":  ["привет", "здравств", "добрый", "добрая", "доброе"],
    "car":    ["машин", "авто", "водител", "поехал", "заглуш"],
    "cuffs":  ["наручник", "задерж", "арест"],
    "radio":  ["рация", "рацию", "эфир", "диспетчер", "код "],
    "smoke":  ["сигарет", "закур", "прикур", "огонька"],
    "help":   ["помощ", "помоги", "скорая", "врач", "ранен"]
  },

  "me": [
    {
      "id": "start", "when": [],
      "next": [
        {"t": "достал паспорт из внутреннего кармана и протянул его", "tags": ["doc"], "w": 1.0},
        {"t": "достал телефон из кармана", "tags": ["phone"], "w": 0.95},
        {"t": "достал кошелёк из внутреннего кармана", "tags": ["money"], "w": 0.9},
        {"t": "остановился и поднял руки на уровень груди", "tags": ["stop", "weapon"], "w": 0.9},
        {"t": "расстегнул кобуру и положил ладонь на рукоять", "tags": ["weapon"], "w": 0.85},
        {"t": "кивнул в знак приветствия", "tags": ["greet"], "w": 0.85},
        {"t": "достал наручники с пояса", "tags": ["cuffs"], "w": 0.8},
        {"t": "поднёс рацию к губам и зажал тангенту", "tags": ["radio"], "w": 0.8},
        {"t": "подошёл к автомобилю и открыл дверь", "tags": ["car"], "w": 0.75},
        {"t": "достал пачку сигарет и закурил", "tags": ["smoke"], "w": 0.7},
        {"t": "внимательно осмотрелся по сторонам", "w": 0.6},
        {"t": "поправил одежду", "w": 0.5}
      ]
    },

    {
      "id": "pocket", "when": ["карман"],
      "unless": ["достал", "вытащ", "нащуп", "вынул", "извлек", "выхват"],
      "next": [
        {"t": "достал оттуда телефон, после чего разблокировал его", "tags": ["phone"], "w": 1.0},
        {"t": "нащупал паспорт и аккуратно вытащил его", "tags": ["doc"], "w": 1.0},
        {"t": "достал кожаный кошелёк", "tags": ["money"], "w": 0.95},
        {"t": "достал ключи от автомобиля", "tags": ["car"], "w": 0.9},
        {"t": "достал рацию", "tags": ["radio"], "w": 0.85},
        {"t": "достал пачку сигарет и зажигалку", "tags": ["smoke"], "w": 0.8}
      ]
    },

    {
      "id": "holster", "when": ["кобур"],
      "unless": ["расстег", "выхват", "достал", "вытащ"],
      "next": [
        {"t": "расстегнул фиксатор, после чего выхватил пистолет", "tags": ["weapon"], "w": 1.0},
        {"t": "достал тазер", "tags": ["cuffs", "stop"], "w": 0.95},
        {"t": "расстегнул фиксатор и положил ладонь на рукоять", "w": 0.9}
      ]
    },
    {
      "id": "holster_open", "when": ["расстег", "фиксатор"], "and": ["кобур", "фиксатор"],
      "unless": ["выхват", "достал", "вытащ"],
      "next": [
        {"t": "выхватил пистолет", "tags": ["weapon"], "w": 1.0},
        {"t": "достал тазер", "w": 0.9},
        {"t": "положил ладонь на рукоять", "w": 0.85}
      ]
    },

    {
      "id": "doc_taken", "when": ["паспорт", "удостоверен", "документ", "прав"],
      "and": ["достал", "вытащ", "вынул", "нащуп", "взял", "выхват"],
      "unless": ["протян", "показ", "предъяв", "отдал", "передал", "раскры"],
      "next": [
        {"t": "протянул его собеседнику", "w": 1.0},
        {"t": "раскрыл его и показал", "w": 0.9},
        {"t": "предъявил его для проверки", "w": 0.85}
      ]
    },
    {
      "id": "phone_taken", "when": ["телефон", "смартфон"],
      "and": ["достал", "вытащ", "вынул", "нащуп", "взял"],
      "unless": ["разблок", "набр", "позвон", "включ", "экран"],
      "next": [
        {"t": "разблокировал его", "w": 1.0},
        {"t": "набрал нужный номер", "tags": ["phone"], "w": 0.95},
        {"t": "посмотрел на экран", "w": 0.8}
      ]
    },
    {
      "id": "wallet_taken", "when": ["кошел", "портмоне"],
      "and": ["достал", "вытащ", "вынул", "нащуп", "взял"],
      "unless": ["раскр", "открыл", "купюр"],
      "next": [
        {"t": "раскрыл его и достал пару купюр", "tags": ["money"], "w": 1.0},
        {"t": "раскрыл его и проверил содержимое", "w": 0.85}
      ]
    },
    {
      "id": "gun_taken", "when": ["пистолет", "оружи"],
      "and": ["достал", "вытащ", "выхват", "вынул", "взял"],
      "unless": ["направ", "навел", "прицел", "выстрел", "передерн", "снял", "опустил"],
      "next": [
        {"t": "направил его в сторону нарушителя", "w": 1.0},
        {"t": "снял его с предохранителя", "w": 0.9},
        {"t": "передёрнул затвор", "w": 0.85}
      ]
    },
    {
      "id": "taser_taken", "when": ["тазер", "тайзер"],
      "and": ["достал", "вытащ", "выхват", "вынул", "взял"],
      "unless": ["направ", "навел", "нажал"],
      "next": [
        {"t": "направил его на нарушителя", "w": 1.0},
        {"t": "нажал на кнопку включения", "w": 0.8}
      ]
    },
    {
      "id": "radio_taken", "when": ["рацию", "рация", "рации"],
      "unless": ["поднес", "зажал", "настро", "частот"],
      "next": [
        {"t": "поднёс её к губам и зажал тангенту", "w": 1.0},
        {"t": "настроил нужную частоту", "w": 0.8}
      ]
    },
    {
      "id": "cuffs_taken", "when": ["наручник"],
      "and": ["достал", "вытащ", "снял", "взял"],
      "unless": ["защелк", "надел", "заков"],
      "next": [
        {"t": "защёлкнул их на запястьях задержанного", "tags": ["cuffs"], "w": 1.0},
        {"t": "раскрыл их и шагнул вперёд", "w": 0.8}
      ]
    },

    {
      "id": "car", "when": ["машин", "автомоб"],
      "unless": ["сел", "завел", "заглуш", "пристег"],
      "next": [
        {"t": "сел за руль и пристегнул ремень безопасности", "w": 1.0},
        {"t": "заглянул в салон", "w": 0.85},
        {"t": "открыл водительскую дверь", "w": 0.8}
      ]
    },
    {
      "id": "car_seat", "when": ["сел"], "and": ["руль", "машин", "автомоб", "водител"],
      "unless": ["завел", "пристег"],
      "next": [
        {"t": "пристегнул ремень безопасности", "w": 1.0},
        {"t": "завёл двигатель", "w": 0.95}
      ]
    },
    {
      "id": "door", "when": ["двер"], "unless": ["машин", "автомоб", "открыл", "распахн", "постуч", "толкн"],
      "next": [
        {"t": "постучал и прислушался", "w": 1.0},
        {"t": "нажал на ручку и приоткрыл её", "w": 0.9},
        {"t": "толкнул её плечом", "w": 0.7}
      ]
    },
    {
      "id": "smoke", "when": ["сигарет", "закур", "прикур", "зажигалк"],
      "unless": ["затян", "затуш"],
      "next": [
        {"t": "щёлкнул зажигалкой и сделал глубокую затяжку", "tags": ["smoke"], "w": 1.0},
        {"t": "затянулся и выпустил струйку дыма", "w": 0.9},
        {"t": "стряхнул пепел на асфальт", "w": 0.7}
      ]
    },
    {
      "id": "call", "when": ["набрал", "позвон"], "unless": ["поднес", "ответ", "дождал"],
      "next": [
        {"t": "поднёс телефон к уху", "w": 1.0},
        {"t": "дождался ответа", "w": 0.8}
      ]
    },
    {
      "id": "approach", "when": ["подошел", "подошла"], "unless": ["поздоров", "представ", "кивнул"],
      "next": [
        {"t": "поздоровался и представился", "tags": ["greet"], "w": 1.0},
        {"t": "кивнул в знак приветствия", "w": 0.9}
      ]
    }
  ],

  "do": [
    {
      "id": "do_phone", "afterMe": ["телефон", "смартфон"],
      "next": [
        {"t": "Телефон находится в правой руке.", "tags": ["phone"], "w": 1.0},
        {"t": "Экран смартфона загорелся.", "w": 0.95},
        {"t": "Телефон в руке, экран разблокирован.", "w": 0.85}
      ]
    },
    {
      "id": "do_unlock", "afterMe": ["разблок"],
      "next": [
        {"t": "Экран смартфона загорелся.", "w": 1.0},
        {"t": "На экране виден рабочий стол.", "w": 0.8}
      ]
    },
    {
      "id": "do_doc", "afterMe": ["паспорт", "удостоверен", "документ", "права"],
      "next": [
        {"t": "Документ находится в правой руке.", "tags": ["doc"], "w": 1.0},
        {"t": "В документе указаны данные владельца.", "w": 0.9},
        {"t": "На странице видна фотография владельца.", "w": 0.8}
      ]
    },
    {
      "id": "do_wallet", "afterMe": ["кошел", "портмоне"],
      "next": [
        {"t": "Кошелёк находится в правой руке.", "w": 1.0},
        {"t": "В кошельке лежат наличные и банковские карты.", "tags": ["money"], "w": 0.9}
      ]
    },
    {
      "id": "do_gun", "afterMe": ["пистолет", "оружи", "кобур", "рукоят"],
      "next": [
        {"t": "Пистолет находится в правой руке.", "tags": ["weapon"], "w": 1.0},
        {"t": "Фиксатор кобуры расстёгнут.", "w": 0.9},
        {"t": "Палец лежит вдоль спусковой скобы.", "w": 0.8}
      ]
    },
    {
      "id": "do_safety", "afterMe": ["предохранител"],
      "next": [{"t": "Предохранитель выключен.", "w": 1.0}]
    },
    {
      "id": "do_taser", "afterMe": ["тазер", "тайзер"],
      "next": [
        {"t": "Тазер находится в правой руке.", "w": 1.0},
        {"t": "Индикатор тазера горит зелёным.", "w": 0.9}
      ]
    },
    {
      "id": "do_radio", "afterMe": ["рацию", "рация", "тангент"],
      "next": [
        {"t": "Рация находится в левой руке.", "tags": ["radio"], "w": 1.0},
        {"t": "Из динамика доносится шум эфира.", "w": 0.85}
      ]
    },
    {
      "id": "do_cuffs", "afterMe": ["наручник"],
      "next": [
        {"t": "Наручники плотно сжимают запястья.", "tags": ["cuffs"], "w": 1.0},
        {"t": "Металлические наручники защёлкнуты.", "w": 0.85}
      ]
    },
    {
      "id": "do_smoke", "afterMe": ["сигарет", "закур", "зажигалк", "затян"],
      "next": [
        {"t": "Сигарета тлеет в правой руке.", "w": 1.0},
        {"t": "Вокруг ощущается запах табачного дыма.", "w": 0.8}
      ]
    },
    {
      "id": "do_door", "afterMe": ["двер"],
      "next": [
        {"t": "Дверь приоткрыта.", "w": 1.0},
        {"t": "За дверью слышны шаги.", "w": 0.7}
      ]
    },
    {
      "id": "do_keys", "afterMe": ["ключ"],
      "next": [{"t": "Связка ключей находится в правой руке.", "w": 1.0}]
    },
    {
      "id": "do_chat_doc", "chat": ["документ", "паспорт", "удостоверен"],
      "next": [
        {"t": "Документы лежат во внутреннем кармане пиджака.", "tags": ["doc"], "w": 1.0},
        {"t": "Паспорт находится при себе.", "w": 0.9}
      ]
    },
    {
      "id": "do_start", "w": 0.5,
      "next": [
        {"t": "Вокруг тихо и спокойно.", "w": 1.0},
        {"t": "Обстановка вокруг спокойная.", "w": 0.9},
        {"t": "На лице спокойное выражение.", "w": 0.8}
      ]
    }
  ],

  "speech": [
    {
      "id": "sp_doc", "chat": ["документ", "паспорт", "удостоверен", "права"],
      "next": ["Вот мои документы", "Держите паспорт", "Пожалуйста, мои документы"]
    },
    {
      "id": "sp_greet", "chat": ["привет", "здравств", "добрый", "добрая", "доброе"],
      "next": ["Здравствуйте", "Добрый день", "Приветствую"]
    },
    {
      "id": "sp_stop", "chat": ["стой", "остановит", "стоять"],
      "next": ["Стойте на месте", "Остановитесь, пожалуйста"]
    },
    {
      "id": "sp_help", "chat": ["помощ", "помоги", "скорая", "ранен"],
      "next": ["Сейчас помогу", "Держитесь, я рядом"]
    },
    {
      "id": "sp_fine", "chat": ["штраф", "нарушен"],
      "next": ["Вот ваш штраф", "Подпишите, пожалуйста"]
    },
    {
      "id": "sp_start", "w": 0.5,
      "next": ["Хорошо", "Понял вас", "Одну секунду"]
    }
  ]
}
